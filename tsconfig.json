{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "void/env"
    ]
  },
  "include": [
    "src",
    "routes",
    "middleware",
    "crons",
    "queues",
    "db"
  ]
}
